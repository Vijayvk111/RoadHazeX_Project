rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin by querying Firestore
    function isAdmin() {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'admin', 'gcc_admin', 'state_highways_admin', 'nhai_admin', 'rural_admin'];
    }

    match /bug_reports/{userId}/{bugReportId}/{fileName} {
      // User can read their own, Admin can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // User can upload to their own folder, size max 2MB (enforced client side, but we cap at 5MB backend just in case)
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024 
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /hazards/{fileName} {
      // Allow read access to anyone for public safety visualization
      allow read: if true;
      // Allow anyone to upload hazard images
      allow write: if true;
    }
  }
}

